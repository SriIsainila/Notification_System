NILIFY_APP_NAME=Nilify API
NILIFY_APP_ENV=development
NILIFY_DEBUG=true
NILIFY_API_PREFIX=/api
NILIFY_HOST=127.0.0.1
NILIFY_PORT=5000

# SQLAlchemy async PostgreSQL URL
NILIFY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/notification_system
NILIFY_DATABASE_ECHO=false

# Generate with: openssl rand -hex 32
NILIFY_JWT_SECRET=replace-with-at-least-32-random-characters
NILIFY_JWT_ALGORITHM=HS256
NILIFY_JWT_EXPIRE_MINUTES=10080
NILIFY_AUTH_COOKIE_NAME=nilify_access_token
NILIFY_AUTH_COOKIE_SECURE=false
NILIFY_AUTH_COOKIE_SAMESITE=lax

# Comma-separated browser origins
NILIFY_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

NILIFY_SCHEDULER_ENABLED=true
NILIFY_SCHEDULER_INTERVAL_SECONDS=300
NILIFY_SCHEDULER_BATCH_SIZE=50
NILIFY_SCHEDULER_CONCURRENCY=5

NILIFY_SCRAPER_TIMEOUT_SECONDS=15
NILIFY_SCRAPER_MAX_BYTES=5000000
NILIFY_SCRAPER_MAX_REDIRECTS=3
NILIFY_SCRAPER_USER_AGENT=NilifyPriceMonitor/1.0
